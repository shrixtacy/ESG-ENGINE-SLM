# ============================================================
# ESGPilot — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ── App ─────────────────────────────────────────────────
APP_NAME=ESGPilot
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
DEBUG=false

# ── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://esgpilot:change_me_strong_password@localhost:5432/esgpilot
DATABASE_URL_SYNC=postgresql://esgpilot:change_me_strong_password@localhost:5432/esgpilot

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                  # Optional — leave blank for local

# ── Auth / JWT ───────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
API_KEY_SALT=change_this_salt_too

# ── SLM Inference ────────────────────────────────────────
# For GPU/vLLM:
VLLM_BASE_URL=http://localhost:8000/v1
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# For dev/CPU (Ollama):
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024

# ── Retrieval ────────────────────────────────────────────
RETRIEVAL_TOP_K=30
RERANK_TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Observability ────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── HuggingFace (for model downloads) ───────────────────
HUGGINGFACE_TOKEN=hf_your_token_here

# ── n8n Automation ───────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change_me
SLACK_CHANNEL_ID=C0XXXXXXXXX       # Slack channel for regulatory alerts

# ── Rate Limits ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
NUDGE_COOLDOWN_SECONDS=300

# ── Langfuse / Secrets ───────────────────────────────────
LANGFUSE_SECRET=changeme-langfuse-secret-32chars
LANGFUSE_SALT=changeme-salt
